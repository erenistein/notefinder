# LLM tabanli OMR icin saglayici secimi ve anahtarlar. Gercek anahtarlari .env'e koy (.env gitignore'da).
# Saglayici: openai | anthropic (bos ise anahtari olan otomatik secilir)
OMR_LLM_PROVIDER=openai

# OpenAI (gpt-4o, gorsel) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (claude-sonnet-4-6) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LilyPond calistirilabilir yolu (PDF uretimi). Bos: once PATH'teki 'lilypond', sonra bilinen
# sabit kurulum yolu denenir. Ozel kurulum icin lilypond.exe (veya bin klasoru) yolunu ver.
LILYPOND_BIN=
